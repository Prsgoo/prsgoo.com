---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

import { localizedPath, toLocale, useTranslations } from "~/i18n/ui";

interface Props {
  project: CollectionEntry<"projects">;
  expandable?: boolean;
}

const { project, expandable = false } = Astro.props;
const { title, description, tags, url, repo, caseStudy } = project.data;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const dialogId = `proj-${project.id.replace(/[^a-z0-9]/gi, "-")}`;

const bodyExcerpt = project.body
  ?.split("\n\n")
  .find(
    (p) =>
      p.trim() &&
      !p.startsWith("#") &&
      !p.startsWith("-") &&
      !p.startsWith("*"),
  )
  ?.trim();
---

<article
  class:list={[
    "card flex flex-col gap-2 rounded-xl p-4",
    expandable && "cursor-pointer",
  ]}
  data-open-dialog={expandable ? dialogId : undefined}
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-medium tracking-tight">{title}</h3>
    {
      expandable && (
        <Icon
          name="lucide:maximize-2"
          class="mt-0.5 h-3.5 w-3.5 shrink-0 text-muted opacity-50"
          aria-hidden="true"
        />
      )
    }
  </div>

  <p
    class:list={[
      "text-sm leading-relaxed text-muted",
      expandable ? "line-clamp-2" : "line-clamp-1",
    ]}
  >
    {description}
  </p>

  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
        {(expandable ? tags.slice(0, 3) : tags).map((tag) => (
          <li class="rounded-full border border-line px-2 py-0.5 font-mono text-xs text-muted">
            {tag}
          </li>
        ))}
        {expandable && tags.length > 3 && (
          <li class="rounded-full border border-line px-2 py-0.5 font-mono text-xs text-muted">
            +{tags.length - 3}
          </li>
        )}
      </ul>
    )
  }

  {
    !expandable && caseStudy && (
      <a
        href={localizedPath(locale, `/journal/${caseStudy}`)}
        class="text-sm text-accent underline-offset-4 hover:underline"
      >
        {t("projects.readCaseStudy")} →
      </a>
    )
  }

  <div class="mt-auto flex gap-4 pt-0.5">
    {
      repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} on GitHub`}
          title="GitHub"
          class="text-muted hover:text-accent"
        >
          <Icon name="simple-icons:github" class="h-5 w-5" />
        </a>
      )
    }
    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} live demo`}
          title="Live demo"
          class="text-muted hover:text-accent"
        >
          <Icon name="lucide:external-link" class="h-5 w-5" />
        </a>
      )
    }
  </div>
</article>

{
  expandable && (
    <dialog
      id={dialogId}
      data-project-dialog
      aria-labelledby={`${dialogId}-title`}
    >
      <div class="card flex flex-col gap-5 rounded-2xl p-6">
        <div class="flex items-start justify-between gap-4">
          <h3
            id={`${dialogId}-title`}
            class="text-lg font-semibold tracking-tight"
          >
            {title}
          </h3>
          <form method="dialog">
            <button
              class="-mt-0.5 shrink-0 text-muted transition-colors hover:text-accent"
              aria-label="Close"
            >
              <Icon name="lucide:x" class="h-5 w-5" />
            </button>
          </form>
        </div>

        <p class="text-sm leading-relaxed text-muted">{description}</p>

        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
              {tags.map((tag) => (
                <li class="rounded-full border border-line px-2 py-0.5 font-mono text-xs text-muted">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }

        {
          bodyExcerpt && (
            <p class="border-t border-line pt-4 text-sm leading-relaxed text-muted">
              {bodyExcerpt}
            </p>
          )
        }

        <div class="flex items-center justify-between border-t border-line pt-2">
          {
            caseStudy ? (
              <a
                href={localizedPath(locale, `/journal/${caseStudy}`)}
                class="text-sm text-accent underline-offset-4 hover:underline"
              >
                {t("projects.readCaseStudy")} →
              </a>
            ) : (
              <span />
            )
          }
          <div class="flex gap-4">
            {
              repo && (
                <a
                  href={repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${title} on GitHub`}
                  title="GitHub"
                  class="text-muted hover:text-accent"
                >
                  <Icon name="simple-icons:github" class="h-5 w-5" />
                </a>
              )
            }
            {
              url && (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${title} live demo`}
                  title="Live demo"
                  class="text-muted hover:text-accent"
                >
                  <Icon name="lucide:external-link" class="h-5 w-5" />
                </a>
              )
            }
          </div>
        </div>
      </div>
    </dialog>
  )
}

<script>
  document
    .querySelectorAll<HTMLElement>("[data-open-dialog]")
    .forEach((card) => {
      card.addEventListener("click", (e) => {
        if ((e.target as Element).closest("a, button, form")) return;
        const id = card.dataset.openDialog!;
        (document.getElementById(id) as HTMLDialogElement | null)?.showModal();
      });
    });

  document
    .querySelectorAll<HTMLDialogElement>("dialog[data-project-dialog]")
    .forEach((dialog) => {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    });
</script>
